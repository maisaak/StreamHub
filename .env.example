# --- StreamHub env ---
ENV=dev
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://streamhub:streamhub@db:5432/streamhub
# For local run without docker: postgresql+asyncpg://streamhub:streamhub@localhost:5432/streamhub
# Fallback for tests/offline: sqlite+aiosqlite:///./streamhub.db
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=change-me-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

SEARCH_CACHE_TTL=900
CARD_CACHE_TTL=3600
PROVIDERS_CACHE_TTL=86400

TMDB_API_KEY=
KINOPOISK_API_KEY=
YOUTUBE_API_KEY=

CELERY_BROKER_URL=redis://redis:6379/1
SHORT_LINK_BASE=https://sh.link
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
